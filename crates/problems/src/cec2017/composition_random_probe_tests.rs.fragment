    // ---- T8: random-point probes vs compiled C reference for fid 21-30
    // (composition functions). Same convention as the fid-11-20 hybrid
    // fragment: 3 seeded random points per dim, ALL 10 composition fids
    // evaluated at each point, compiled-C `%.20f` output transcribed as Rust
    // f64 literals. Seed `20170721` (distinct from T7's `20170717`, this
    // task's own choice).

    #[test]
    fn composition_random_probe_dim10_trial0_matches_compiled_c() {
        let x: [f64; 10] = [-53.591945, -72.664741, -95.282728, -53.63611, 52.587714, -7.409575, 61.784933, 34.622462, 0.378036, -59.382623];
        assert_close(Cec2017::new(21, 10).unwrap().eval_one(&x), 2890.661772637393, "fid=21 dim=10 trial=0");
        assert_close(Cec2017::new(22, 10).unwrap().eval_one(&x), 5883.236833939416, "fid=22 dim=10 trial=0");
        assert_close(Cec2017::new(23, 10).unwrap().eval_one(&x), 3186.018959477454, "fid=23 dim=10 trial=0");
        assert_close(Cec2017::new(24, 10).unwrap().eval_one(&x), 3817.0687680313335, "fid=24 dim=10 trial=0");
        assert_close(Cec2017::new(25, 10).unwrap().eval_one(&x), 8527.740897173166, "fid=25 dim=10 trial=0");
        assert_close(Cec2017::new(26, 10).unwrap().eval_one(&x), 14394.096396143288, "fid=26 dim=10 trial=0");
        assert_close(Cec2017::new(27, 10).unwrap().eval_one(&x), 3441.9422163752697, "fid=27 dim=10 trial=0");
        assert_close(Cec2017::new(28, 10).unwrap().eval_one(&x), 7914.540562163723, "fid=28 dim=10 trial=0");
        assert_close(Cec2017::new(29, 10).unwrap().eval_one(&x), 3626820.2991623958, "fid=29 dim=10 trial=0");
        assert_close(Cec2017::new(30, 10).unwrap().eval_one(&x), 4898681011.755351, "fid=30 dim=10 trial=0");
    }

