    // ---- random-point probes vs compiled C reference (T6 report has the
    // full probe-driver transcript; 3 seeded random points per dim, ALL 9
    // fids evaluated at each point, `%.20f`-printed compiled-C output
    // transcribed as Rust f64 literals -- `repr()`-shortest-round-trip so
    // each literal parses back to the EXACT same f64 bit pattern the C
    // printed).

    #[test]
    fn random_probe_dim10_trial0_matches_compiled_c() {
        let x: [f64; 10] = [-60.12734, -62.294422, 2.64638, -9.050228, -84.364168, 12.431495, 57.543432, 36.338521, 13.141879, -18.437569];
        assert_close(Cec2017::new(1, 10).unwrap().eval_one(&x), 25921188238.590782, "fid=1 dim=10 trial=0");
        assert_close(Cec2017::new(3, 10).unwrap().eval_one(&x), 93762900738.32567, "fid=3 dim=10 trial=0");
        assert_close(Cec2017::new(4, 10).unwrap().eval_one(&x), 8990.40525004093, "fid=4 dim=10 trial=0");
        assert_close(Cec2017::new(5, 10).unwrap().eval_one(&x), 880.3893509707664, "fid=5 dim=10 trial=0");
        assert_close(Cec2017::new(6, 10).unwrap().eval_one(&x), 734.3450609870108, "fid=6 dim=10 trial=0");
        assert_close(Cec2017::new(7, 10).unwrap().eval_one(&x), 1539.9147118826793, "fid=7 dim=10 trial=0");
        assert_close(Cec2017::new(8, 10).unwrap().eval_one(&x), 973.0646162371556, "fid=8 dim=10 trial=0");
        assert_close(Cec2017::new(9, 10).unwrap().eval_one(&x), 7239.912777415651, "fid=9 dim=10 trial=0");
        assert_close(Cec2017::new(10, 10).unwrap().eval_one(&x), 5145.534916179743, "fid=10 dim=10 trial=0");
    }

