        let x: [f64; 10] = [50.862957, -82.976018, 60.535481, 65.772566, 45.638114, 37.10104, -36.560395, -54.390462, 96.742088, -47.500664];
        assert_close(Cec2017::new(1, 10).unwrap().eval_one(&x), 65061900085.78007, "fid=1 dim=10 trial=1");
        assert_close(Cec2017::new(3, 10).unwrap().eval_one(&x), 3902469691.716093, "fid=3 dim=10 trial=1");
        assert_close(Cec2017::new(4, 10).unwrap().eval_one(&x), 60512.67794833491, "fid=4 dim=10 trial=1");
        assert_close(Cec2017::new(5, 10).unwrap().eval_one(&x), 802.7957150133325, "fid=5 dim=10 trial=1");
        assert_close(Cec2017::new(6, 10).unwrap().eval_one(&x), 744.2426259704315, "fid=6 dim=10 trial=1");
        assert_close(Cec2017::new(7, 10).unwrap().eval_one(&x), 2198.374881728694, "fid=7 dim=10 trial=1");
        assert_close(Cec2017::new(8, 10).unwrap().eval_one(&x), 1055.170500339385, "fid=8 dim=10 trial=1");
        assert_close(Cec2017::new(9, 10).unwrap().eval_one(&x), 20413.145335238503, "fid=9 dim=10 trial=1");
        assert_close(Cec2017::new(10, 10).unwrap().eval_one(&x), 4180.275261497093, "fid=10 dim=10 trial=1");
    }

