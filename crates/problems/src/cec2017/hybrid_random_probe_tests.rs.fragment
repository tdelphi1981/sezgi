    // ---- T7: random-point probes vs compiled C reference for fid 11-20
    // (hybrid functions). Same convention as the fid-1-10 fragment above:
    // 3 seeded random points per dim, ALL 10 hybrid fids evaluated at each
    // point, compiled-C `%.20f` output transcribed as Rust f64 literals.

    #[test]
    fn hybrid_random_probe_dim10_trial0_matches_compiled_c() {
        let x: [f64; 10] = [-20.344211, -37.799083, -61.419184, 2.949703, -81.095187, 92.005463, 71.91296, 99.928808, 78.365357, 31.021084];
        assert_close(Cec2017::new(11, 10).unwrap().eval_one(&x), 9687027356.456701, "fid=11 dim=10 trial=0");
        assert_close(Cec2017::new(12, 10).unwrap().eval_one(&x), 17330313293.749077, "fid=12 dim=10 trial=0");
        assert_close(Cec2017::new(13, 10).unwrap().eval_one(&x), 1912436525.0279949, "fid=13 dim=10 trial=0");
        assert_close(Cec2017::new(14, 10).unwrap().eval_one(&x), 16007158566.759407, "fid=14 dim=10 trial=0");
        assert_close(Cec2017::new(15, 10).unwrap().eval_one(&x), 439613204.3669987, "fid=15 dim=10 trial=0");
        assert_close(Cec2017::new(16, 10).unwrap().eval_one(&x), 3519.819703373298, "fid=16 dim=10 trial=0");
        assert_close(Cec2017::new(17, 10).unwrap().eval_one(&x), 2785.2164807410045, "fid=17 dim=10 trial=0");
        assert_close(Cec2017::new(18, 10).unwrap().eval_one(&x), 82451440266.18767, "fid=18 dim=10 trial=0");
        assert_close(Cec2017::new(19, 10).unwrap().eval_one(&x), 18950737401.145645, "fid=19 dim=10 trial=0");
        assert_close(Cec2017::new(20, 10).unwrap().eval_one(&x), 3714.6894267891475, "fid=20 dim=10 trial=0");
    }

