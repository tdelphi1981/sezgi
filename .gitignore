/target

# R build artifacts (r-sezgi)
r-sezgi/src/*.o
r-sezgi/src/*.so
r-sezgi/src/*.dll
r-sezgi/src/Makevars
r-sezgi/src/Makevars.win
r-sezgi/src/rust/target/
r-sezgi.Rcheck/
r-sezgi_*.tar.gz

# CRAN/R-universe release-embed generated artifacts (tools/make-cran-tree.sh)
/dist/
